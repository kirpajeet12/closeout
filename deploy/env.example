# copy to deploy/.env ON THE SERVER; never commit the real one
CLOSEOUT_HOST=closeout.example.com
CLOSEOUT_ACCESS_CODE=change-me
CLOSEOUT_OFFICE=the engineer's office
CLOSEOUT_MODEL_ID=us.anthropic.claude-sonnet-4-6
CLOSEOUT_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Natural voice for spoken answers (optional). Without a key the phone's own voice reads the answer.
OPENAI_API_KEY=

# Sending the covering message by email (optional). A sender address verified on Amazon SES in the server's region;
# the server's role needs ses:SendEmail. Without it the engineer's own mail app opens with the message filled in.
CLOSEOUT_MAIL_FROM=

# Connecting the office's Gmail (optional). Create an OAuth client of type "Web application" in Google Cloud console,
# add https://<your host>/api/mail/callback as an authorised redirect URI, enable the Gmail API, and paste the two
# values here. The engineer then presses "Connect Gmail" on the Office page once. Closeout reads only replies to
# messages it sent and mail carrying the label below; it never sends anything without the engineer's press.
CLOSEOUT_GOOGLE_CLIENT_ID=
CLOSEOUT_GOOGLE_CLIENT_SECRET=
CLOSEOUT_MAIL_LABEL=
# Connecting the office's Microsoft 365 or Outlook mailbox (optional). In the Azure portal open Microsoft Entra ID >
# App registrations > New registration, pick "Accounts in any organizational directory and personal Microsoft accounts",
# add a Web redirect URI https://<your host>/api/mail/callback/microsoft, then under Certificates & secrets make a client
# secret and paste its Value here. API permissions (delegated, Microsoft Graph): offline_access, openid, email, User.Read,
# Mail.ReadWrite, Mail.Send. The engineer then presses "Sign in with Microsoft" on the Office page once.
CLOSEOUT_MICROSOFT_CLIENT_ID=
CLOSEOUT_MICROSOFT_CLIENT_SECRET=
# common = work and personal accounts; put your directory (tenant) id here to allow only your organisation's accounts
CLOSEOUT_MICROSOFT_TENANT=commonCloseout
