# copy to deploy/.env ON THE SERVER; never commit the real one
CLOSEOUT_HOST=closeout.example.com
CLOSEOUT_ACCESS_CODE=change-me
CLOSEOUT_OFFICE=the engineer's office
CLOSEOUT_MODEL_ID=us.anthropic.claude-sonnet-4-6
CLOSEOUT_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Natural voice for spoken answers (optional). Without a key the phone's own voice reads the answer.
OPENAI_API_KEY=

# Sending the covering message by email (optional). A sender address verified on Amazon SES in the server's region;
# the server's role needs ses:SendEmail. Without it the engineer's own mail app opens with the message filled in.
CLOSEOUT_MAIL_FROM=
