# Caddy is the front door: it gets and renews the HTTPS certificate by itself
# and passes requests to the app. {$CLOSEOUT_HOST} comes from the server's .env.
{$CLOSEOUT_HOST} {
    encode gzip
    request_body {
        max_size 512MB
    }
    reverse_proxy app:8765 {
        transport http {
            read_timeout 600s
        }
    }
}

# The judges' copy (see the try service). Without CLOSEOUT_TRY_HOST it answers only on try.localhost.
{$CLOSEOUT_TRY_HOST:try.localhost} {
    encode gzip
    request_body {
        max_size 512MB
    }
    reverse_proxy try:8765 {
        transport http {
            read_timeout 600s
        }
    }
}
