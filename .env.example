# Model provider: "bedrock" (default, uses your AWS credentials) or "anthropic"
CLOSEOUT_MODEL_PROVIDER=bedrock
# Bedrock model ids (cross-region inference profiles)
CLOSEOUT_MODEL_ID=us.anthropic.claude-sonnet-4-6
CLOSEOUT_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1
# Only needed when CLOSEOUT_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Where the SQLite database and run outputs live
CLOSEOUT_DATA_DIR=./data
